# ============================================================
# 1. DELTA EXCHANGE INDIA (6H Four-Pod Balanced)
# ============================================================
# Use 'testnet' for paper trading (https://demo.delta.exchange)
# 'prod' supports public-data dry runs only; production orders are disabled.
DELTA_ENV=testnet
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Keep DRY_RUN=true for local paper mode; set DRY_RUN=false for testnet orders.
DRY_RUN=true

# Candle timeframe (validated on 6h)
DELTA_RESOLUTION=6h

# Donchian 0.30, Supertrend + ADX 0.25, momentum 0.25, funding + volume squeeze 0.35.
DELTA_STRATEGY_MODE=four_pod_balanced

# Blank selects venue defaults: four coins on testnet, five including BNBUSD on prod.
# Set a comma-separated list only to override the venue default.
DELTA_SYMBOLS=

# Legacy Config C only. Four-Pod Balanced currently uses collared IOC entries.
DELTA_MAKER_ENTRY=true
DELTA_MAKER_TIMEOUT_SEC=15.0

# Account equity in USD for Delta Exchange sizing ($1,200 ~ Rs 1,02,000)
DELTA_CAPITAL_USD=1200.0

# Persistent directory for state JSON, trade journal CSV, lockfile, and rotating logs
BOT_DATA_DIR=.

# ============================================================
# 2. KOTAK NEO NSE ETF ROTATION / MCX ADVISOR (Sleeve 2 — Rs 98,000)
# ============================================================
KOTAK_CAPITAL_INR=98000.0
# Strategy mode: 'rotation' (All-6 Top-2 Vol-Parity ETFs + LIQUIDBEES, daily) or 'config_c' (6h GOLDPETAL + SILVERBEES)
KOTAK_STRATEGY_MODE=rotation
KOTAK_RESOLUTION=6h
# Data source: 'upstox' (native INR NSE/MCX, default) or 'yfinance'
KOTAK_DATA_SOURCE=upstox
# Only used in legacy 'yfinance' proxy mode
USD_INR_RATE=85.0

# ============================================================
# 3. UPSTOX API (Sleeve 2 Native INR MCX/NSE Candles + Nifty Tools)
# ============================================================
UPSTOX_ACCESS_TOKEN=your_upstox_daily_access_token_here

# ============================================================
# 4. OPTIONAL TELEGRAM ALERTS
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
