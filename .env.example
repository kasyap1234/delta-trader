# ============================================================
# 1. DELTA EXCHANGE INDIA (Sleeve 1: 6H Multi-Coin Donchian Bot — Config C)
# ============================================================
# Use 'testnet' for paper trading (https://demo.delta.exchange)
# 'prod' supports public-data dry runs only; production orders are disabled.
DELTA_ENV=testnet
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Keep DRY_RUN=true for local paper mode; set DRY_RUN=false for testnet orders.
DRY_RUN=true

# Candle timeframe (Config C validated on 6h)
DELTA_RESOLUTION=6h

# 5-coin basket (Config C defaults: BTCUSD,ETHUSD,SOLUSD,BNBUSD,DOGEUSD)
DELTA_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,BNBUSD,DOGEUSD

# Post-only Maker limit entries with short timeout fallback to collared IOC
DELTA_MAKER_ENTRY=true
DELTA_MAKER_TIMEOUT_SEC=15.0

# Account equity in USD for Delta Exchange sizing ($1,200 ~ Rs 1,02,000)
DELTA_CAPITAL_USD=1200.0

# Persistent directory for state JSON, trade journal CSV, lockfile, and rotating logs
BOT_DATA_DIR=.

# ============================================================
# 2. KOTAK NEO MCX + NSE METALS ADVISOR (Sleeve 2 — Rs 98,000)
# ============================================================
KOTAK_CAPITAL_INR=98000.0
KOTAK_RESOLUTION=6h
USD_INR_RATE=85.0

# ============================================================
# 3. OPTIONAL UPSTOX API (Legacy Engine B Nifty Validator)
# ============================================================
UPSTOX_ACCESS_TOKEN=your_upstox_daily_access_token_here

# ============================================================
# 4. OPTIONAL TELEGRAM ALERTS
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
