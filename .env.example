# ============================================================
# 1. DELTA EXCHANGE INDIA (Engine A: 4H/6H Donchian Live/Paper Bot)
# ============================================================
# Use 'testnet' for paper trading (https://demo.delta.exchange)
# Switch to 'prod' ONLY after authenticated testnet validation
DELTA_ENV=testnet
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Safety Switches:
# Keep DRY_RUN=true for local paper mode; set DRY_RUN=false for testnet orders.
# Production orders require BOTH DELTA_ENV=prod, DRY_RUN=false, AND ALLOW_PROD_ORDERS=true.
DRY_RUN=true
ALLOW_PROD_ORDERS=false

# Candle timeframe: 4h (higher CAGR) or 6h (lowest drawdown / highest Calmar)
DELTA_RESOLUTION=4h

# Account equity in USD for Delta Exchange sizing (e.g., 1200 USD ~ Rs 1,00,000)
DELTA_CAPITAL_USD=1200.0

# ============================================================
# 2. UPSTOX PRO / PLUS API (Engine B: Real Nifty Option Data & Advisor)
# ============================================================
UPSTOX_ACCESS_TOKEN=your_upstox_daily_access_token_here

# ============================================================
# 3. OPTIONAL TELEGRAM ALERTS
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
