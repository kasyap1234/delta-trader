# ============================================================
# 1. DELTA EXCHANGE INDIA (Engine A: 4H Donchian Live/Paper Bot)
# ============================================================
# Testnet account: https://demo.delta.exchange/
# 'prod' supports public-data dry runs only; production orders are disabled.
DELTA_ENV=testnet
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Safety Switch: Keep 'true' to simulate orders locally without hitting exchange
DRY_RUN=true

# Account equity in USD for Delta Exchange sizing (e.g., 1200 USD ~ Rs 1,00,000)
DELTA_CAPITAL_USD=1200.0

# ============================================================
# 2. UPSTOX PRO API V3 (Engine B: Nifty Spread Advisor & Backtests)
# ============================================================
UPSTOX_ACCESS_TOKEN=your_upstox_daily_access_token_here

# ============================================================
# 3. OPTIONAL TELEGRAM ALERTS
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
