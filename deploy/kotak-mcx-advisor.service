[Unit]
Description=Kotak Neo MCX GOLDPETAL + NSE SILVERBEES 6H Paper/Signal Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/live_kotak_mcx_advisor.py --paper-auto
MemoryMax=384M
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
